# --- Supabase ---
# Project URL and keys: Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key: server-side ONLY, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Mikrotik RouterOS API ---
# The router must have the API service enabled (IP > Services > api or api-ssl).
MIKROTIK_HOST=192.168.88.1
MIKROTIK_PORT=8728
MIKROTIK_USE_TLS=false
MIKROTIK_USER=api-user
MIKROTIK_PASSWORD=change-me
# Hotspot server name vouchers are issued against (IP > Hotspot > Servers)
MIKROTIK_HOTSPOT_SERVER=hotspot1
# If true, Mikrotik calls are skipped and logged instead (useful for local dev without a router)
MIKROTIK_MOCK=true

# --- Cron / scheduled jobs ---
# Shared secret required in the "Authorization: Bearer <secret>" header when
# calling /api/cron/expire-vouchers from an external scheduler.
CRON_SECRET=change-me
